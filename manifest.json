{
  "manifest_version": 3,
  "name": "ADZERO",
  "short_name": "ADZERO",
  "version": "3.1.2",
  "description": "Premium ad and tracker protection for a quieter web.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "declarativeNetRequestFeedback",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "tracker_rules",
        "enabled": true,
        "path": "rules/trackers.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ADZERO",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js",
        "youtube.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}